import { HmiPalette, HmiTheme, HmiMath } from "theme.slint";

export struct TrendSample { time: float, value: float }
export struct TrendSeries { label: string, color: color, samples: [TrendSample] }

export component LiveTrend inherits Rectangle {
    in property <HmiPalette> palette: HmiTheme.palette;
    in property <string> title: "Live trend";
    in property <string> unit;
    in property <[TrendSeries]> series;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> time-minimum: 0;
    in property <float> time-maximum: 60;
    in property <string> time-start-label: "−60 s";
    in property <string> time-end-label: "Now";
    in property <int> decimals: 1;
    in property <int> grid-divisions: 4;
    in property <length> line-width: 2px;
    in property <bool> show-legend: true;
    in property <bool> show-threshold: false;
    in property <float> threshold: 80;
    in property <string> threshold-label: "High limit";
    in property <color> threshold-color: palette.warning;
    in property <bool> available: true;
    in property <bool> cursor-enabled: true;
    out property <bool> range-valid: maximum > minimum && time-maximum > time-minimum;
    out property <bool> cursor-visible: cursor-enabled && (plot-touch.has-hover || plot-touch.pressed) && range-valid && available && has-data;
    out property <float> cursor-time: time-minimum + clamp(plot-touch.mouse-x / max(1px, plot.width), 0, 1) * (time-maximum - time-minimum);
    // Override to false when channels are configured but contain no readings yet.
    in property <bool> has-data: series.length > 0;
    callback cursor-moved(float);
    min-width: 300px; min-height: 240px;
    preferred-width: 600px; preferred-height: 300px;
    background: root.palette.surface;
    border-width: 1px; border-color: root.palette.border; border-radius: 14px;
    accessible-role: groupbox; accessible-label: root.title + " " + root.unit;

    VerticalLayout {
        padding: 16px; spacing: 10px;
        HorizontalLayout {
            height: 22px;
            Text { text: root.title; color: root.palette.text; font-size: 14px; font-weight: 600; overflow: elide; }
            // Position the geometry-dependent label explicitly so its intrinsic
            // text size never participates in the plot's layout negotiation.
            Rectangle {
                width: 120px;
                Text {
                    x: 0px; y: 0px;
                    text: root.cursor-visible ? "t " + HmiMath.reading(root.cursor-time, 1) + " s" : root.unit;
                    color: root.palette.muted; font-size: 11px; horizontal-alignment: right; overflow: elide;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 42px;
                for tick in clamp(root.grid-divisions, 1, 8) + 1: Text {
                    y: (parent.height - 16px) * tick / clamp(root.grid-divisions, 1, 8);
                    height: 16px; width: parent.width;
                    text: HmiMath.reading(root.maximum - tick * (root.maximum - root.minimum) / clamp(root.grid-divisions, 1, 8), root.decimals);
                    color: root.palette.muted; font-size: 10px; horizontal-alignment: right;
                }
            }
            plot := Rectangle {
                clip: true;
                background: root.palette.elevated;
                border-radius: 6px;
                for tick in clamp(root.grid-divisions, 1, 8) + 1: Rectangle {
                    y: (parent.height - 1px) * tick / clamp(root.grid-divisions, 1, 8);
                    height: 1px; background: root.palette.border;
                }
                for tick in 5: Rectangle {
                    x: (parent.width - 1px) * tick / 4;
                    width: 1px; background: root.palette.border;
                }
                if root.show-threshold && root.range-valid && root.threshold >= root.minimum && root.threshold <= root.maximum: Rectangle {
                    y: parent.height * (1 - HmiMath.fraction(root.threshold, root.minimum, root.maximum));
                    height: 1px; background: root.threshold-color;
                    Text {
                        x: max(0px, parent.width - self.preferred-width - 8px);
                        y: parent.y > 22px ? -20px : 4px;
                        text: root.threshold-label; color: root.threshold-color; font-size: 10px;
                    }
                }
                for channel in root.series: Rectangle {
                    // Each segment uses real time coordinates, including irregular samples.
                    for sample[index] in channel.samples: Path {
                        visible: index > 0 && root.range-valid && root.available && root.has-data;
                        width: parent.width; height: parent.height;
                        viewbox-width: 1; viewbox-height: 1; fit: fill;
                        stroke: channel.color; stroke-width: clamp(root.line-width, 1px, 8px);
                        stroke-line-cap: round;
                        MoveTo {
                            x: (channel.samples[max(0, index - 1)].time - root.time-minimum) / max(0.000001, root.time-maximum - root.time-minimum);
                            y: 1 - (channel.samples[max(0, index - 1)].value - root.minimum) / max(0.000001, root.maximum - root.minimum);
                        }
                        LineTo {
                            x: (sample.time - root.time-minimum) / max(0.000001, root.time-maximum - root.time-minimum);
                            y: 1 - (sample.value - root.minimum) / max(0.000001, root.maximum - root.minimum);
                        }
                    }
                    for sample[index] in channel.samples: Rectangle {
                        // Hold the last sample at/before the cursor; never invent readings.
                        visible: root.range-valid && root.available && root.has-data && sample.time >= root.time-minimum && sample.time <= root.time-maximum && sample.value >= root.minimum && sample.value <= root.maximum && (channel.samples.length == 1 || (root.cursor-visible && sample.time <= root.cursor-time && (index == channel.samples.length - 1 || channel.samples[min(index + 1, channel.samples.length - 1)].time > root.cursor-time)));
                        width: 6px; height: 6px; border-radius: 3px;
                        x: parent.width * HmiMath.fraction(sample.time, root.time-minimum, root.time-maximum) - 3px;
                        y: parent.height * (1 - HmiMath.fraction(sample.value, root.minimum, root.maximum)) - 3px;
                        background: channel.color;
                    }
                }
                if root.cursor-visible: Rectangle {
                    x: clamp(plot-touch.mouse-x, 0px, parent.width - 1px);
                    width: 1px; background: root.palette.muted;
                }
                if !root.range-valid || !root.available || !root.has-data: Text {
                    text: !root.range-valid ? "Invalid range" : !root.available ? "No signal" : "Waiting for samples";
                    color: root.palette.text; font-size: 13px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                plot-touch := TouchArea {
                    enabled: root.cursor-enabled;
                    mouse-cursor: crosshair;
                    // Touch/mouse drag reports the same time as the hover crosshair.
                    moved => { if root.range-valid && root.available { root.cursor-moved(root.cursor-time); } }
                    clicked => { if root.range-valid && root.available { root.cursor-moved(root.cursor-time); } }
                }
            }
        }
        HorizontalLayout {
            padding-left: 50px; height: 14px;
            Text { text: root.time-start-label; color: root.palette.muted; font-size: 10px; }
            Text { text: root.time-end-label; color: root.palette.muted; font-size: 10px; horizontal-alignment: right; }
        }
        if root.show-legend: HorizontalLayout {
            height: 22px; spacing: 16px;
            for channel in root.series: HorizontalLayout {
                spacing: 6px;
                Rectangle { width: 8px; height: 8px; y: 7px; border-radius: 4px; background: channel.color; }
                Text { text: channel.label; color: root.palette.muted; font-size: 11px; overflow: elide; }
                Rectangle {
                    min-width: 48px;
                    Text {
                        visible: !root.cursor-visible;
                        text: !root.available || channel.samples.length == 0 ? "—" : HmiMath.reading(channel.samples[max(0, channel.samples.length - 1)].value, root.decimals);
                        color: root.palette.text; font-size: 11px; horizontal-alignment: right;
                    }
                    Text { visible: root.cursor-visible && (channel.samples.length == 0 || root.cursor-time < channel.samples[0].time); text: "—"; color: root.palette.muted; font-size: 11px; horizontal-alignment: right; }
                    for sample[index] in channel.samples: Text {
                        visible: root.cursor-visible && sample.time <= root.cursor-time && (index == channel.samples.length - 1 || channel.samples[min(index + 1, channel.samples.length - 1)].time > root.cursor-time);
                        text: HmiMath.reading(sample.value, root.decimals); color: channel.color;
                        font-size: 11px; horizontal-alignment: right;
                    }
                }
            }
        }
    }
}
